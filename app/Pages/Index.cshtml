@page
@model IndexModel
@{ ViewData["Title"] = "Select a tool"; ViewData["PageClass"] = "landing-page"; }
<section class="tool-directory" aria-labelledby="directory-title">
    <div class="directory-head">
        <h1 id="directory-title">Select a tool</h1>
        <p>Certificates and digital signatures.</p>
    </div>
    <div class="tool-selector">
        <a class="tool-card pki" asp-page="/Login" asp-route-module="Pki">
            <div class="tool-card-top">
                <span class="tool-icon" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none"><path d="M19 5H8a2 2 0 0 0-2 2v18a2 2 0 0 0 2 2h9M19 5l7 7M19 5v7h7v6M11 11h3m-3 5h9m-9 5h5"/><circle cx="24" cy="23" r="4"/><path d="m21 26-1 5 4-2 4 2-1-5"/></svg></span>
                <span class="module-name">PKI</span>
            </div>
            <h2>Certificates</h2>
            <p>Request a diagnostic user certificate.</p>
            <dl class="tool-specs"><div><dt>Input</dt><dd>CSR or certificate details</dd></div><div><dt>Output</dt><dd>X.509 certificate</dd></div></dl>
            <span class="card-action">Open PKI <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5"/></svg></span>
        </a>
        <a class="tool-card dss" asp-page="/Login" asp-route-module="Dss">
            <div class="tool-card-top">
                <span class="tool-icon" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none"><path d="m7 22 1-6L22 2a2.8 2.8 0 0 1 4 4L12 20l-5 2Zm12-17 4 4M5 28h22M17 22h10"/></svg></span>
                <span class="module-name">DSS</span>
            </div>
            <h2>Digital signatures</h2>
            <p>Sign a digest or text with your project key.</p>
            <dl class="tool-specs"><div><dt>Input</dt><dd>Hash or UTF-8 text</dd></div><div><dt>Output</dt><dd>Independent signature</dd></div></dl>
            <span class="card-action">Open DSS <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5"/></svg></span>
        </a>
    </div>
    <p class="directory-note">Sign in with the account assigned to each tool.</p>
</section>
