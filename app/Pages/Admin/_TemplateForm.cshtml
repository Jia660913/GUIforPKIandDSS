@model TemplateEditor
@{ var input = Model.Input; var prefix = $"template-{input.Id}"; }
<form method="post" asp-page-handler="SaveTemplate" class="inline-form compact">
    <input type="hidden" name="TemplateInput.Id" value="@input.Id" />
    <div><label for="@prefix-name">Display name</label><input id="@prefix-name" name="TemplateInput.DisplayName" value="@input.DisplayName" maxlength="160" required /></div>
    <div><label for="@prefix-profile">Exact supplier cert_profile</label><input id="@prefix-profile" name="TemplateInput.CertProfile" value="@input.CertProfile" maxlength="160" required /></div>
    <div><label for="@prefix-env">Environment / TrustGrade</label><select id="@prefix-env" name="TemplateInput.EnvironmentName"><option value="development" selected="@(input.EnvironmentName == "development")">Development / dev</option><option value="production" selected="@(input.EnvironmentName == "production")">Production / field</option></select></div>
    <div><label for="@prefix-connection">PKI connection</label><select id="@prefix-connection" name="TemplateInput.SupplierConnectionId"><option value="">Not configured</option>@foreach (var connection in Model.Page.Connections) { <option value="@connection.Id" selected="@(input.SupplierConnectionId == connection.Id)">@connection.Name · @AdminModel.EnvironmentLabel(connection.EnvironmentName)@(connection.Active ? "" : " · disabled")</option> }</select></div>
    <div class="config-wide"><label for="@prefix-role">Diagnostic role</label><select id="@prefix-role" name="TemplateInput.DiagUserRole"><option value="">Select a role</option>@foreach (var role in PkiRoleCatalog.All) { <option value="@role.Hex" selected="@(input.DiagUserRole == role.Hex)">@role.Name · 0x@role.Hex · @role.ValidityDays days@(role.RequiresUniqueId ? " · Unique ID required" : "")</option> }</select></div>
    <p class="helper-text config-wide">The diagnostic role defines permitted diagnostic operations for the ECU variant and customer identified by ECU Variant ID. CertType is diagUser; role and validity follow the supplier profile.</p>
    <div><label for="@prefix-variant">Exact Variant ID length (bytes)</label><input id="@prefix-variant" name="TemplateInput.VariantExactBytes" value="@input.VariantExactBytes" type="number" min="0" max="16" required /><small class="helper-text">0 permits 1–16 bytes. Use the confirmed API limit.</small></div>
    <div><label for="@prefix-extra">Additional CSR extensions</label><select id="@prefix-extra" name="TemplateInput.ExtraExtensionsPolicy"><option value="reject" selected="@(input.ExtraExtensionsPolicy == "reject")">Reject unrecognized extensions</option><option value="ignore" selected="@(input.ExtraExtensionsPolicy == "ignore")">Accept after supplier confirmation</option></select></div>
    <div><label for="@prefix-cn">Common Name pattern (optional)</label><input id="@prefix-cn" name="TemplateInput.CommonNamePattern" value="@input.CommonNamePattern" maxlength="512" spellcheck="false" /><small class="helper-text">Confirmed regular expression; blank adds no format restriction.</small></div>
    <div><label for="@prefix-unique">ECU Unique ID pattern (optional)</label><input id="@prefix-unique" name="TemplateInput.UniqueIdPattern" value="@input.UniqueIdPattern" maxlength="512" spellcheck="false" /></div>
    <label class="check config-wide"><input type="checkbox" name="TemplateInput.IncludeFixedFieldsInCsr" value="true" checked="@input.IncludeFixedFieldsInCsr" /> Include CA-fixed type, trust grade and role in generated CSR</label><input type="hidden" name="TemplateInput.IncludeFixedFieldsInCsr" value="false" />
    <label class="check"><input type="checkbox" name="TemplateInput.VariantCritical" value="true" checked="@input.VariantCritical" /> Variant extension is critical</label><input type="hidden" name="TemplateInput.VariantCritical" value="false" />
    <label class="check"><input type="checkbox" name="TemplateInput.UniqueCritical" value="true" checked="@input.UniqueCritical" /> Unique extension is critical</label><input type="hidden" name="TemplateInput.UniqueCritical" value="false" />
    <label class="check config-wide"><input type="checkbox" name="TemplateInput.FixedFieldsCritical" value="true" checked="@input.FixedFieldsCritical" /> CA-fixed CSR extensions are critical, when included</label><input type="hidden" name="TemplateInput.FixedFieldsCritical" value="false" />
    <label class="check config-wide"><input type="checkbox" name="TemplateInput.CsrPolicyConfirmed" value="true" checked="@input.CsrPolicyConfirmed" /> CSR fields and immediate-issuance behavior confirmed for this profile</label><input type="hidden" name="TemplateInput.CsrPolicyConfirmed" value="false" />
    <label class="check"><input type="checkbox" name="TemplateInput.Active" value="true" checked="@input.Active" /> Enable template</label><input type="hidden" name="TemplateInput.Active" value="false" />
    <button class="secondary-button" type="submit">Save template mapping</button>
</form>
