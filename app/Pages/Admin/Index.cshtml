@page
@model AdminModel
@{ ViewData["Title"] = "Administration"; }
<div class="section-head"><div><h1>Administration</h1><p class="lede">Manage accounts, access and supplier integration.</p></div><div class="head-meta">@Model.ModuleLabel</div></div>
@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="@(Model.MessageIsError ? "validation" : "notice success-note")" role="@(Model.MessageIsError ? "alert" : "status")">@Model.Message</div>
}
<div asp-validation-summary="All" class="validation" role="alert"></div>
<div class="admin-grid">
    <section class="admin-section">
        <div class="section-title"><h2>Tool accounts</h2><span class="status-text">@Model.Users.Count accounts</span></div>
        <details class="config-editor" open="@(Model.SubmittedForm == "CreateUser")">
            <summary>Add account</summary>
            <form method="post" asp-page-handler="CreateUser" class="inline-form">
                <div><label asp-for="NewUsername">Username</label><input asp-for="NewUsername" maxlength="80" autocomplete="off" required /></div>
                <div><label asp-for="NewDisplayName">Display name</label><input asp-for="NewDisplayName" maxlength="120" autocomplete="off" /></div>
                <div><label asp-for="NewPassword">Initial password</label><input name="NewPassword" id="NewPassword" placeholder="At least 12 characters" type="password" minlength="12" maxlength="256" autocomplete="new-password" required /></div>
                @if (Model.IsDss)
                {
                    <div><label asp-for="NewProjectId">DSS project</label><select asp-for="NewProjectId" required><option value="">Select a project</option>@foreach (var project in Model.Projects.Where(x => x.Active)) { <option value="@project.Id">@project.Code · @project.DisplayName</option> }</select></div>
                }
                <button class="secondary-button" type="submit">Add account</button>
            </form>
        </details>
        <div class="admin-list">
        @foreach (var user in Model.Users)
        {
            <div class="admin-row">
                <div><strong>@user.Username</strong><small>@user.DisplayName · @(user.Active ? "Active" : "Revoked") @if (user.Role == UserRole.Admin) { <span>· Administrator</span> } @if (Model.IsDss && user.Role != UserRole.Admin) { <span>· @(user.DssProject?.Code ?? "No project")</span> }</small></div>
                @if (user.Role == UserRole.User)
                {
                    @if (Model.IsDss)
                    {
                        <form method="post" asp-page-handler="ChangeProject" class="project-change"><input type="hidden" name="id" value="@user.Id" /><label for="project-@user.Id" class="visually-hidden">Project for @user.Username</label><select name="projectId" id="project-@user.Id" required><option value="">Select a project</option>@foreach (var project in Model.Projects.Where(x => x.Active)) { <option value="@project.Id" selected="@(project.Id == user.DssProjectId)">@project.Code</option> }</select><button class="text-button" type="submit">Update project</button></form>
                    }
                    <form method="post" asp-page-handler="ToggleUser"><input type="hidden" name="id" value="@user.Id" /><button class="text-button" type="submit" aria-label="@(user.Active ? $"Revoke {user.Username}" : $"Activate {user.Username}")">@(user.Active ? "Revoke" : "Activate")</button></form>
                    <form method="post" asp-page-handler="ResetPassword"><input type="hidden" name="id" value="@user.Id" /><button class="text-button" type="submit" aria-label="Reset password for @user.Username">Reset password</button></form>
                }
            </div>
        }
        </div>
    </section>

    <section class="admin-section">
        <div class="section-title"><h2>Integration settings</h2><span class="status-text">@Model.Connections.Count connections</span></div>
        <p class="helper-text">API addresses and access certificates connect this tool to the existing supplier service.</p>
        <details class="config-editor integration-settings" open="@(Model.SubmittedForm == "SaveConnection")">
            <summary><span>Connection settings</span><small>@Model.Connections.Count(x => x.Active) enabled · administrator setup</small></summary>
        <p class="helper-text">Set up each environment once. Saving a connection changes how this tool calls the supplier API.</p>
        <details class="config-editor" open="@(Model.SubmittedForm == "SaveConnection" && Model.ConnectionInput.Id == 0)">
            <summary>Add connection</summary>
            <partial name="_ConnectionForm" model="Model.ConnectionEditorFor()" />
        </details>
        @foreach (var connection in Model.Connections)
        {
            <details class="config-editor" open="@(Model.SubmittedForm == "SaveConnection" && Model.ConnectionInput.Id == connection.Id)">
                <summary><span>@connection.Name</span><small>@(Model.IsDss ? (connection.EnvironmentName == "production" ? "Production" : "Development") : AdminModel.EnvironmentLabel(connection.EnvironmentName)) @if (Model.IsDss) { <span>· @connection.Project?.Code</span> } · @Model.ConnectionState(connection)</small></summary>
                <partial name="_ConnectionForm" model="Model.ConnectionEditorFor(connection)" />
            </details>
        }
        @if (Model.Connections.Count == 0) { <p class="helper-text">No connections registered. Save incomplete configurations as disabled.</p> }
        </details>
        @if (Model.IsDss)
        {
            <p class="helper-text">The API can read a known key, sign and verify. It does not list projects or keys. Register each exact key name, then refresh its supplier details.</p>
        }
    </section>

    @if (!Model.IsDss)
    {
        <section class="admin-section">
            <div class="section-title"><h2>Certificate templates</h2><span class="status-text">@PkiRoleCatalog.All.Count diagnostic roles</span></div>
            <p class="helper-text">Each role has a mapping for Development and Production / field. @Model.Templates.Count(x => x.Active) mappings are enabled.</p>
            <details class="config-editor" open="@(Model.SubmittedForm == "SaveTemplate" && Model.TemplateInput.Id == 0)">
                <summary>Add template mapping</summary>
                <partial name="_TemplateForm" model="Model.TemplateEditorFor()" />
            </details>
            @foreach (var environment in new[] { "development", "production" })
            {
                var templates = Model.Templates.Where(x => x.EnvironmentName == environment).ToList();
                <details class="config-editor" open="@(Model.SubmittedForm == "SaveTemplate" && Model.TemplateInput.EnvironmentName == environment)">
                    <summary><span>@AdminModel.EnvironmentLabel(environment)</span><small>@templates.Count templates · @templates.Count(x => x.Active) enabled</small></summary>
                    @foreach (var template in templates)
                    {
                        <details class="config-editor" open="@(Model.SubmittedForm == "SaveTemplate" && Model.TemplateInput.Id == template.Id)">
                            <summary><span>@template.DisplayName</span><small>@AdminModel.TemplateState(template)</small></summary>
                            <partial name="_TemplateForm" model="Model.TemplateEditorFor(template)" />
                        </details>
                    }
                </details>
            }
        </section>
        <section class="admin-section">
            <div class="section-title"><h2>Certificate roles</h2><span class="status-text">11 available roles</span></div>
            <p class="helper-text">ECU Variant ID identifies the ECU variant and customer. The diagnostic role sets its diagnostic permissions. Both are required in every user certificate.</p>
            <p class="helper-text">ECU Unique ID identifies one physical ECU. It is required for Development and Claims, and optional for the other roles.</p>
            <div class="admin-list">
            @foreach (var role in PkiRoleCatalog.All)
            {
                <div class="admin-row"><div><strong>@role.Name</strong><small>0x@(role.Hex) · @role.ValidityDays days · @(role.RequiresUniqueId ? "Unique ID required" : "Unique ID optional")</small></div></div>
            }
            </div>
            <p class="helper-text">OEM Claims is reserved and is not enabled.</p>
        </section>
    }
    else
    {
        <section class="admin-section">
            <div class="section-title"><h2>Project access</h2><span class="status-text">@Model.Projects.Count projects</span></div>
            <p class="helper-text">Group tool accounts and registered signing keys by project. Ordinary users can sign only with their assigned project's keys; administrators can access all projects.</p>
            <details class="config-editor" open="@(Model.SubmittedForm == "SaveProject" && Model.ProjectInput.Id == 0)">
                <summary>Add access group</summary>
                <partial name="_ProjectForm" model="Model.ProjectFormFor()" />
            </details>
            @foreach (var project in Model.Projects)
            {
                <details class="config-editor" open="@(Model.SubmittedForm == "SaveProject" && Model.ProjectInput.Id == project.Id)">
                    <summary><span>@project.Code · @project.DisplayName</span><small>@(project.Active ? "Active" : "Disabled") · @project.Keys.Count registered keys</small></summary>
                    <partial name="_ProjectForm" model="Model.ProjectFormFor(project)" />
                </details>
            }
            <p class="helper-text">These groups control access within this tool. Supplier projects and keys remain managed in the supplier system.</p>
        </section>
        <section class="admin-section">
            <div class="section-title"><h2>Signing keys</h2><span class="status-text">@Model.Projects.Sum(x => x.Keys.Count) registered</span></div>
            <p class="helper-text">Register an existing supplier key for a project and environment. Refresh reads its algorithm, public key and status from the supplier.</p>
            <details class="config-editor" open="@(Model.SubmittedForm == "SaveKey" && Model.KeyInput.Id == 0)">
                <summary>Register signing key</summary>
                <partial name="_KeyForm" model="Model.KeyEditorFor()" />
            </details>
            @foreach (var project in Model.Projects)
            {
                @foreach (var key in project.Keys.OrderBy(x => x.EnvironmentName).ThenBy(x => x.Name))
                {
                    <details class="config-editor" open="@((Model.SubmittedForm == "SaveKey" && Model.KeyInput.Id == key.Id) || (Model.SubmittedForm == "RefreshKey" && Model.RefreshKeyId == key.Id))">
                        <summary><span>@key.Name</span><small>@project.Code · @(key.EnvironmentName == "production" ? "Production" : "Development") · @AdminModel.KeyState(key)</small></summary>
                        <div class="supplier-key-details">
                            <p class="helper-text">@AdminModel.SupplierKeySummary(key)</p>
                            <form method="post" asp-page-handler="RefreshKey"><input type="hidden" name="id" value="@key.Id" /><button class="secondary-button" type="submit" disabled="@(!Model.CanRefreshKey(key))">Refresh from supplier</button></form>
                            @if (!Model.CanRefreshKey(key)) { <p class="helper-text">Complete and enable the DSS connection to refresh supplier details.</p> }
                        </div>
                        <partial name="_KeyForm" model="Model.KeyEditorFor(key)" />
                    </details>
                }
            }
        </section>
    }
</div>
