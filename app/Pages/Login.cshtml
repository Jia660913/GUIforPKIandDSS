@page
@model LoginModel
@{ ViewData["Title"] = "登录"; }
<section class="auth-layout">
    <div class="auth-context"><span class="eyebrow">SECURE ACCESS</span><h1>进入你的<br /><em>@Model.ModuleLabel</em>工作区</h1><p>使用工具系统账号登录。供应商后台账号不会在这里使用。</p><a asp-page="/Index" class="back-link">← 返回工具选择</a></div>
    <form method="post" class="auth-panel">
        <input type="hidden" asp-for="Module" /><div class="panel-label">工具账号登录</div><h2>@Model.ModuleLabel</h2>
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <label asp-for="Username">账号</label><input asp-for="Username" autocomplete="username" placeholder="输入工具账号" />
        <label asp-for="Password">密码</label><input asp-for="Password" type="password" autocomplete="current-password" placeholder="输入密码" />
        <button class="primary-button" type="submit">登录工作区 <span>→</span></button><p class="form-note">首次登录后需要修改初始密码。</p>
    </form>
</section>
