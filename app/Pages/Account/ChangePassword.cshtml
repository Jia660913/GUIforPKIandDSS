@page
@model ChangePasswordModel
@{ ViewData["Title"] = "修改密码"; }
<section class="form-page narrow"><div class="eyebrow">ACCOUNT SECURITY</div><h1>更新工具密码</h1><p class="lede">使用新密码保护你的工具账号。</p><form method="post" class="form-panel"><div asp-validation-summary="ModelOnly" class="validation"></div><label asp-for="CurrentPassword">当前密码</label><input asp-for="CurrentPassword" type="password" autocomplete="current-password" /><label asp-for="NewPassword">新密码</label><input asp-for="NewPassword" type="password" autocomplete="new-password" /><label asp-for="ConfirmPassword">确认新密码</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" /><button class="primary-button" type="submit">保存新密码 <span>→</span></button></form></section>
