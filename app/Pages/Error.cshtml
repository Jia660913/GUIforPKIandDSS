@page
@model ErrorModel
@{ ViewData["Title"] = "Request error"; }
<section class="form-page narrow">
    <h1>Unable to complete your request</h1>
    <p class="lede">Try again. If the issue persists, contact your tool administrator.</p>
    @if (Model.ShowRequestId) { <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p> }
    <a class="secondary-button" asp-page="/Index">Return to tools</a>
</section>
