@page
@model PrivacyModel
@{ ViewData["Title"] = "Data and privacy"; }
<section class="form-page narrow">
    <h1>Data and privacy</h1>
    <p>Certificate request and signing records are retained for one year. Users can view their own records; tool administrators can view all records within their tool.</p>
    <p>Generated PKI private keys are provided for download and are not stored in request history.</p>
</section>
