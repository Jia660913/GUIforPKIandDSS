@page
@model DssIndexModel
@{ ViewData["Title"] = "DSS 签名"; }
<div class="section-head"><div><div class="eyebrow">DSS / PACKAGE SIGNING</div><h1>生成独立签名值</h1><p class="lede">输入摘要或短字符串，使用当前项目下的密钥完成签名。</p></div><div class="project-badge">@(Model.IsDemoMode ? "演示模式" : "供应商接口") · 项目 <strong>@(Model.Project?.Code ?? "未绑定")</strong></div></div>
@if (Model.Project is null) { <div class="empty-state"><div class="empty-icon">!</div><h2>账号尚未绑定 DSS 项目</h2><p>请联系 DSS 管理员分配项目后再使用签名工具。</p></div> }
else {
<div class="workspace-grid"><form method="post" class="form-panel workspace-form"><div asp-validation-summary="ModelOnly" class="validation"></div><div class="step-label"><span>01</span>选择密钥</div><label asp-for="KeyId">项目密钥</label><select asp-for="KeyId"><option value="">选择 @Model.Project.Code 项目密钥</option>@foreach (var key in Model.Keys) { <option value="@key.Id">@key.Name · @key.SignAlgorithm</option> }</select><div class="step-label"><span>02</span>签名输入</div><div class="mode-switch"><label><input type="radio" asp-for="InputMode" value="hash" checked />摘要值</label><label><input type="radio" asp-for="InputMode" value="text" />字符串</label></div><label asp-for="InputValue">输入内容</label><textarea asp-for="InputValue" rows="8" placeholder="摘要模式：输入偶数位十六进制；字符串模式：输入需要签名的文本"></textarea><small id="input-help">摘要会按原始字节签名，不会再次计算哈希；最大输入 1 MiB（可配置）。</small><button class="primary-button" type="submit">计算签名 <span>→</span></button></form><aside class="side-rail"><div class="rail-card"><span class="rail-label">项目边界</span><h3>@Model.Project.DisplayName</h3><p>你只能看到这个项目的密钥。提交时后端会再次校验项目归属。</p></div><div class="rail-card quiet"><span class="rail-label">当前算法</span><p>Ed25519 · 供应商 `key-sign-text` 接口</p></div></aside></div>
}
@if (Model.Result is not null) { <section class="result-panel @(Model.Result.Success ? "success" : "failure")"><div class="result-title">@(Model.Result.Success ? "签名已生成" : "签名未完成")</div><p>@(Model.Result.Success ? "请复制或下载独立签名值。" : Model.Result.Error)</p>@if (Model.Result.Success) { <textarea id="signature-result" readonly>@Model.Result.Signature</textarea><button class="secondary-button" type="button" onclick="copySignature()">复制签名值</button> }</section> }
@section Scripts { <script>function copySignature(){navigator.clipboard.writeText(document.getElementById('signature-result').value);const b=event.currentTarget;b.textContent='已复制';setTimeout(()=>b.textContent='复制签名值',1500);}</script> }
