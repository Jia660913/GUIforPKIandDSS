@page
@model PkiIndexModel
@using ZfTools.Data
@using ZfTools.Services
@{ ViewData["Title"] = "PKI certificates"; }
<div class="section-head">
    <div><h1>Request a certificate</h1><p class="lede">Choose an environment and diagnostic certificate template, then enter the ECU details or upload a CSR.</p></div>
    <div class="head-meta"><span class="status-dot"></span>@(Model.IsDemoMode ? "Demo · no certificates issued" : "Supplier API mode")</div>
</div>
<div class="workspace-grid">
    <form method="post" enctype="multipart/form-data" class="form-panel workspace-form" id="pki-form">
        <div asp-validation-summary="All" class="validation" role="alert"></div>
        <div class="step-label"><span>01</span>Certificate template</div>
        <div class="field-grid">
            <div><label asp-for="EnvironmentName">Environment</label><select asp-for="EnvironmentName"><option value="development">Development · dev</option><option value="production">Production · field</option></select></div>
            <div><label asp-for="TemplateId">Certificate template</label>
                <select asp-for="TemplateId"><option value="">Select a template</option>
                    @foreach (var item in Model.Templates)
                    {
                        var role = PkiRoleCatalog.Find(item.DiagUserRole);
                        <option value="@item.Id" hidden="@(item.EnvironmentName != Model.EnvironmentName)" disabled="@(item.EnvironmentName != Model.EnvironmentName)" data-environment="@item.EnvironmentName" data-requires-unique="@(role?.RequiresUniqueId == true ? "true" : "false")" data-role="@(role?.Name ?? "Unconfigured role")" data-validity="@(role?.ValidityDays.ToString() ?? "—")" data-variant-bytes="@item.VariantExactBytes" data-ready="@(PkiService.GetReadinessErrors(item).Count == 0 ? "true" : "false")">@item.DisplayName</option>
                    }
                </select>
            </div>
        </div>
        <small id="template-summary">Select a template to view its diagnostic role and validity.</small>
        <div class="step-label"><span>02</span>Certificate request</div>
        <div class="mode-switch" role="group" aria-label="CSR source">
            <label><input type="radio" asp-for="CsrMode" id="csr-generate" value="generate" />Generate a CSR</label>
            <label><input type="radio" asp-for="CsrMode" id="csr-upload" value="upload" />Upload a CSR</label>
        </div>
        <div id="generate-fields">
            <div class="field-grid">
                <div><label asp-for="EcuVariantId">ECU Variant ID <span class="optional">Required</span></label><input asp-for="EcuVariantId" placeholder="e.g. 0040000100000000" aria-describedby="variant-help" aria-required="true" /><small id="variant-help">Identifies the ECU variant and customer. Hexadecimal, up to 16 bytes.</small></div>
                <div><label asp-for="EcuUniqueId">ECU Unique ID <span class="optional" id="unique-requirement">Optional</span></label><input asp-for="EcuUniqueId" placeholder="Enter the individual ECU identifier" aria-describedby="unique-help" /><small id="unique-help">Identifies one ECU. Up to 32 UTF-8 bytes. Required for Development and Claims; optional for other roles.</small></div>
            </div>
            <label asp-for="CommonName">CSR Common Name</label><input asp-for="CommonName" placeholder="Enter the configured certificate identity" />
            <small>Creates an Ed25519 key pair. Save the private key before submitting the CSR.</small>
        </div>
        <div id="upload-fields" hidden>
            <label asp-for="CsrFile">CSR file</label>
            <div class="file-picker">
                <input asp-for="CsrFile" type="file" accept=".csr,.pem,.txt" aria-describedby="upload-help" />
                <span class="file-picker-action" aria-hidden="true">Choose CSR</span>
                <span id="csr-file-name" aria-hidden="true">No file selected</span>
            </div>
            <small id="upload-help">Public PEM request, up to 128 KiB. ECU identifiers and Common Name are read from the CSR and checked against the selected template.</small>
        </div>
        <button class="secondary-button" type="submit" asp-page-handler="Preview" id="preview-button">Prepare CSR</button>
        @if (Model.Preview is not null)
        {
            <div class="step-label"><span>03</span>Review and submit</div>
            <dl class="request-summary">
                <dt>Common Name</dt><dd>@Model.Preview.CommonName</dd>
                <dt>ECU Variant ID</dt><dd>@Model.Preview.VariantId</dd>
                <dt>ECU Unique ID</dt><dd>@(Model.Preview.UniqueId ?? "Not included")</dd>
                <dt>Diagnostic role</dt><dd>@PkiRoleCatalog.Find(Model.SelectedTemplate?.DiagUserRole)?.Name</dd>
                <dt>Environment</dt><dd>@(Model.EnvironmentName == "production" ? "Production · field" : "Development · dev")</dd>
            </dl>
            @if (Model.GeneratedPrivateKey is not null)
            {
                <div class="validation" role="status">Save your private key now. It is not retained and cannot be recovered after leaving this page.</div>
                <button class="secondary-button" type="button" onclick="downloadText('private-key-result','private-key.pem')">Download private key</button>
                <textarea id="private-key-result" hidden>@Model.GeneratedPrivateKey</textarea>
            }
            <button class="secondary-button" type="button" onclick="downloadText('csr-preview','request.csr')">Download CSR</button>
            <textarea id="csr-preview" hidden>@Model.Preview.Pem</textarea>
            @if (Model.CsrMode == "generate" && !string.IsNullOrEmpty(Model.PreparedCsr))
            {
                <label class="checkbox-label"><input asp-for="PrivateKeySaved" />I have saved the private key for this CSR.</label>
            }
            @if (!Model.IsDemoMode && Model.ReadinessErrors.Count > 0)
            {
                <div class="validation" role="status"><strong>Connection not ready.</strong> Ask an administrator to complete this template's supplier mapping.</div>
            }
        }
        <textarea asp-for="PreparedCsr" hidden></textarea>
        <button class="primary-button" type="submit" asp-page-handler="Apply" id="apply-button" disabled="@(string.IsNullOrEmpty(Model.PreparedCsr) || (!Model.IsDemoMode && Model.ReadinessErrors.Count > 0))">@(Model.IsDemoMode ? "Validate demo request" : "Request certificate") <span aria-hidden="true">→</span></button>
        <small id="prepare-again" hidden>The request details changed. Prepare the CSR again before submitting.</small>
    </form>
    <aside class="side-rail" aria-label="Certificate request notes">
        <div class="rail-card"><span class="rail-label">Certificate scope</span><h3>ECU and permissions</h3><p>ECU Variant ID identifies the ECU variant and customer, such as OGM for DAF or OGM for IVECO.</p><p>The diagnostic role is a certificate extension that determines which diagnostic operations are permitted on that ECU. It is set by your selected template.</p></div>
        <div class="rail-card quiet"><span class="rail-label">Private key</span><p>The supplier receives the public CSR only. Your private key is not stored in request history.</p><span class="rail-label">Request history</span><p>Records are retained for one year. A timeout may leave issuance unresolved; check the request ID before retrying.</p></div>
    </aside>
</div>
@if (Model.Result is not null)
{
    var title = Model.Result.Status switch { "succeeded" => "Certificate issued and validated", "demo" => "Demo validation completed", "unknown" => "Certificate request needs checking", _ => "Certificate request failed" };
    <section class="result-panel @(Model.Result.Success || Model.Result.Status == "demo" ? "success" : "failure")" aria-live="polite">
        <h2 class="result-title">@title</h2><p>Request ID: @Model.Result.RequestId</p>
        @if (Model.Result.Error is not null) { <p>@Model.Result.Error</p> }
        @if (Model.Result.Success)
        {
            <label for="certificate-result">Certificate</label><textarea id="certificate-result" readonly>@Model.Result.Certificate</textarea>
            <button class="secondary-button" type="button" onclick="downloadText('certificate-result','certificate.pem')">Download certificate</button>
        }
    </section>
}
@section Scripts {
<script>
    const environment = document.getElementById('EnvironmentName');
    const templates = document.getElementById('TemplateId');
    const prepared = document.getElementById('PreparedCsr');
    function updateTemplates() {
        for (const option of templates.options) {
            const excluded = option.value && option.dataset.environment !== environment.value;
            option.hidden = !!excluded; option.disabled = !!excluded;
        }
        if (templates.selectedOptions[0]?.disabled) templates.value = '';
        updateTemplateFields();
    }
    function updateTemplateFields() {
        const option = templates.selectedOptions[0];
        const required = option?.dataset.requiresUnique === 'true';
        document.getElementById('unique-requirement').textContent = required ? 'Required' : 'Optional';
        document.getElementById('EcuUniqueId').setAttribute('aria-required', String(required));
        const bytes = Number(option?.dataset.variantBytes || 0);
        document.getElementById('variant-help').textContent = `Identifies the ECU variant and customer. ${bytes ? `Hexadecimal, exactly ${bytes} bytes.` : 'Hexadecimal, up to 16 bytes.'}`;
        document.getElementById('template-summary').textContent = option?.value ? `Diagnostic role: ${option.dataset.role} · Validity: ${option.dataset.validity} days${option.dataset.ready === 'true' ? '' : ' · Supplier mapping pending'}` : 'Select a template to view its diagnostic role and validity.';
    }
    function updateCsrMode() {
        const upload = document.querySelector('input[name="CsrMode"]:checked')?.value === 'upload';
        document.getElementById('upload-fields').hidden = !upload;
        document.getElementById('generate-fields').hidden = upload;
        document.getElementById('preview-button').textContent = upload ? 'Read and validate CSR' : 'Generate key and CSR';
    }
    function invalidatePrepared() {
        if (!prepared.value) return;
        prepared.value = '';
        document.getElementById('apply-button').disabled = true;
        document.getElementById('prepare-again').hidden = false;
        const saved = document.getElementById('PrivateKeySaved'); if (saved) saved.checked = false;
    }
    environment.addEventListener('change', () => { invalidatePrepared(); updateTemplates(); });
    templates.addEventListener('change', () => { invalidatePrepared(); updateTemplateFields(); });
    document.querySelectorAll('input[name="CsrMode"]').forEach(input => input.addEventListener('change', () => { invalidatePrepared(); updateCsrMode(); }));
    for (const id of ['EcuVariantId','EcuUniqueId','CommonName','CsrFile']) document.getElementById(id).addEventListener('input', invalidatePrepared);
    document.getElementById('CsrFile').addEventListener('change', event => {
        document.getElementById('csr-file-name').textContent = event.target.files[0]?.name || 'No file selected';
    });
    updateTemplates(); updateCsrMode();
    function downloadText(id, name) {
        const link = document.createElement('a');
        const url = URL.createObjectURL(new Blob([document.getElementById(id).value], { type: 'text/plain' }));
        link.href = url; link.download = name; document.body.appendChild(link); link.click(); link.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
    }
</script>
}
