@using System.Security.Claims
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    var isEntryPage = currentPage is "/Index" or "/Login";
    var moduleHome = User.FindFirstValue("module") == "Dss" ? "/Dss" : "/Pki";
    var backFallback = isEntryPage || User.Identity?.IsAuthenticated != true || currentPage is "/Pki/Index" or "/Dss/Index" ? "/" : moduleHome;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ZF Div.I PKI &amp; DSS System</title>
    <link rel="icon" type="image/svg+xml" href="~/images/zf-logo.svg" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(ViewData["PageClass"] as string)">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="topbar">
        <a class="brand" asp-page="/Index" aria-label="Cybersecurity Engineering: PKI & DSS System home"><img class="brand-logo" src="~/images/zf-logo.svg" alt="ZF" width="42" height="42" /><span>Cybersecurity Engineering: PKI &amp; DSS System</span></a>
        @if (!isEntryPage && User.Identity?.IsAuthenticated == true)
        {
            <nav class="nav-links" aria-label="Main navigation">
                @if (User.FindFirstValue("module") == "Pki") { <a asp-page="/Pki/Index" aria-current="@(currentPage == "/Pki/Index" ? "page" : null)">Certificates</a> }
                @if (User.FindFirstValue("module") == "Dss") { <a asp-page="/Dss/Index" aria-current="@(currentPage == "/Dss/Index" ? "page" : null)">Signing</a> }
                <a asp-page="/History/Index" aria-current="@(currentPage == "/History/Index" ? "page" : null)">History</a>
                @if (User.IsInRole("Admin")) { <a asp-page="/Admin/Index" aria-current="@(currentPage == "/Admin/Index" ? "page" : null)">Administration</a> }
            </nav>
            <div class="account-chip"><a asp-page="/Account/ChangePassword" class="account-name" title="Change password">@User.Identity.Name</a><form method="post" asp-page="/Logout"><button class="signout" type="submit">Sign out</button></form></div>
        }
    </header>
    <main id="main-content" class="page-shell">@RenderBody()</main>
    <footer class="footer">
        @if (currentPage != "/Index")
        {
            <a class="footer-back" href="@backFallback" data-back-link><span aria-hidden="true">←</span> Back</a>
        }
        <div class="footer-support"><span>Technical support · ZF CVS China Cybersecurity</span><a href="mailto:CVSChinaCybersecurity@zf.com">CVSChinaCybersecurity@zf.com</a></div>
    </footer>
    <script src="~/js/navigation.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
