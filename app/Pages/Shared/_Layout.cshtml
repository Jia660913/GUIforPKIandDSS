@using System.Security.Claims
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · ZF 工具台</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-page="/Index"><span class="brand-mark">Z</span><span>ZF 工具台</span></a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <nav class="nav-links" aria-label="主导航">
                @if (User.FindFirstValue("module") == "Pki") { <a asp-page="/Pki/Index">PKI 证书</a> }
                @if (User.FindFirstValue("module") == "Dss") { <a asp-page="/Dss/Index">DSS 签名</a> }
                <a asp-page="/History/Index">记录</a>
                @if (User.IsInRole("Admin")) { <a asp-page="/Admin/Index">管理</a> }
            </nav>
            <div class="account-chip"><span>@User.Identity.Name</span><form method="post" asp-page="/Logout"><button class="signout" type="submit">退出</button></form></div>
        }
    </header>
    <main class="page-shell">@RenderBody()</main>
    <footer class="footer">ZF 工具台 · 本地部署基线 · 记录保留 1 年</footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
